{
  "name": "react-web-mobile",
  "version": "2.1.0",
  "description": ">## A Big Update Is Coming",
  "main": "server.js",
  "scripts": {
    "start": "cross-env LOCAL_RUN_ENV=stage node ./scripts/start.js",
    "prestart": "rimraf ./dist && yarn && node ./scripts/prestart.js",
    "analyzer:stats": "yarn prebuild && cross-env NODE_ENV=production WEBPACK_STATS=1 webpack --stats=detailed --json=compilation-stats.json --progress -c dist/.webpack.config.js",
    "analyzer": "yarn prebuild && cross-env NODE_ENV=production  ANALYZER=1 webpack --progress -c dist/.webpack.config.js",
    "start:qa2": "yarn prestart && cross-env LOCAL_RUN_ENV=qa2 node ./scripts/start.js",
    "start:prd": "yarn prestart && cross-env LOCAL_RUN_ENV=production node ./scripts/start.js",
    "test": "jest",
    "test:base": "jest ./src/tests/basetests/",
    "lint": "eslint --quiet --cache -c ./.eslintrc.js ./src",
    "e2e-test": "jest -c ./jest.e2e.config.js --detectOpenHandles --verbose",
    "test-stage:e2e": "cross-env E2E_ENV=stage yarn e2e-test",
    "test-prod:e2e": "cross-env E2E_ENV=prod yarn e2e-test",
    "test-local:e2e": "cross-env E2E_ENV=localStage yarn e2e-test",
    "build": "node ./scripts/build.js",
    "prebuild": "rimraf ./dist && node ./scripts/getConfigFile.js",
    "build:prod": "cross-env NODE_ENV=production yarn build",
    "devops:stage": "devops build start --name react-web-mobile_stage",
    "devops:qa2": "devops build start --name react-web-mobile_qa2"
  },
  "author": "MIC",
  "license": "ISC",
  "browserslist": [
    "cover 99.8%"
  ],
  "lint-staged": {
    "./**/*.{js,ts,tsx}": "eslint --quiet --fix -c ./.eslintrc.js"
  },
